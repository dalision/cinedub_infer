# CineDub environment overrides (all optional).
# Copy to `.env`, edit, and load with:  set -a; source .env; set +a
# (the `set -a` step is what actually exports the variables to child
# processes like `torchrun` and `huggingface-cli`.)

# HuggingFace credentials — needed to pull gated aux models (Gemma-T5) and
# the CineDub weights from https://huggingface.co/Dalision/cinedub.
# Get a token at:
#   https://huggingface.co/settings/tokens
export HF_TOKEN=hf_your_token_here

# Model checkpoint locations (used by scripts/demo_infer.sh).
# Layout after `huggingface-cli download Dalision/cinedub --local-dir weights/cinedub`:
#   weights/cinedub/model_config.json
#   weights/cinedub/checkpoint/step=300000.ckpt
export CKPT=weights/cinedub/checkpoint/step=300000.ckpt
export CKPT_MULTISPEAKER=${CKPT}    # unified: one checkpoint drives V2A / V2S / V2SA

# Model config (shipped one, matches the ap_m4 checkpoint)
export MODEL_CONFIG=stable_audio_tools/configs/model_configs/txt2audio/stable_audio_ours_vt2as_translarge_cleanemb_ap.json

# Output directory (demo script mkdir -p's it)
export SAVE_DIR=exp/demo

# Sampling knobs
export CFG=7
export STEPS=100

# Offline weight overrides (uncomment if you have local copies)
# export CINEDUB_CLIP_LOCAL=/path/to/DFN5B-CLIP-ViT-H-14-384      # dir OR .bin file
# export CINEDUB_SYNCHFORMER_CKPT=/path/to/synchformer_state_dict.pth
# export CINEDUB_TTS_VOCAB=/path/to/vocab.txt
